# Node.js dependency tree (installed via pnpm)
node_modules/

# TypeScript build artifacts
*.tsbuildinfo

# Compiled output (unused while noEmit is active)
lib/

# Local test caches
.coverage/

# Recursive-mode disposable scratchpad (R5): never committed, never an Input
.recursive/run/*/scratch/
.recursive/run/*/scratch.*
/.recursive/config/recursive-router-discovered.json

# Reusable-repo hygiene: run residue is NEVER committed.
# Rule source: references/agents-block.md (§ reusable-repo hygiene).
# The source checkout committed 256 files under .recursive/run/ against this rule;
# this repo is where the checker (check-reusable-repo-hygiene) is meant to be wired in.
.recursive/run/

# T15 enforcement evidence traces (rolling, bounded, git-ignored per plan §4 T15 step 4).
# Local evidence, not a control-plane artifact: the guard decision log and the
# observed-write tamper log are regenerated as the plugin runs, and committing them
# would put machine-specific absolute paths and timestamps into a reusable repo.
.recursive/config/guard-decisions.jsonl
.recursive/config/observed-tampers.jsonl

# T39: the run layer also appears NESTED, under the test fixtures' own repos. The rules above
# contain a slash, so they are ANCHORED to this directory and never matched `tests/fixtures/...`
# — a lint run against a fixture left an untracked `jobs/` behind that appeared in every
# `git status`. Recursive residue is residue wherever it lands.
**/.recursive/run/

# Editor/agent scratch files inside the generated map tree (never part of the artifact)
workflow-map/.tmp-*
workflow-map/*.tmp.mjs

